{
  "name": "luck-today",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:ios": "tsc --noEmit && CAPACITOR=1 vite build",
    "cap:sync": "npm run build:ios && npx cap sync ios",
    "cap:open": "npx cap open ios",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/cli": "^7.6.6",
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "iztro": "^2.5.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "taobi": "^0.4.5",
    "tyme4ts": "^1.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
